# 复制为 .env 并填写（.env 已被 gitignore，勿提交）
LIYUAN_API_BASE=https://tokenrhythm.studio/v1
LIYUAN_API_KEY=你的_API_Key
LIYUAN_MODEL=deepseek-v4-flash-0731
# 可选：模型分级——记账/压缩用更便宜的模型（缺省跟随主模型）
# LIYUAN_SCRIBE_MODEL=deepseek-v4-flash-0731
# LIYUAN_COMPRESS_MODEL=deepseek-v4-flash-0731
# 可选：上下文预算（字符，默认 24000 ≈ 8k token）
# LIYUAN_CONTEXT_BUDGET_CHARS=24000
# 可选：agent 循环上限（默认 10）
# LIYUAN_MAX_LOOP_TURNS=10
